rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coleções públicas (apenas leitura)
    match /noticias/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Dados do usuário — apenas o próprio dono
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Coleção legacy de transações (RTDB mirror) — apenas dono
    match /transactions/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Coleções globais de configuração
    match /categories/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Negar todo o resto por segurança
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
