rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coleções públicas (apenas leitura)
    match /noticias/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Dados do usuário — apenas o próprio dono
    match /users/{userId}/agenda/_nexus/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && !document.startsWith('agenda/_nexus');
    }

    // Coleção legacy de transações (RTDB mirror) — apenas dono
    match /transactions/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Categorias por usuário — apenas o próprio dono pode escrever
    match /categories/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Negar todo o resto por segurança
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
